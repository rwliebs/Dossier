# Dossier — Configuration
#
# For self-deploy: use the web setup at /setup (recommended) or edit
# ~/.dossier/config directly. This .env.example is for reference only.
#
# For development: copy to .env.local and fill in values.
# Config precedence: process.env > .env.local > ~/.dossier/config

# ── Required ─────────────────────────────────────────────────────────
# Anthropic API key for planning LLM and agentic-flow builds
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# GitHub token for pushing branches and listing repos (optional if you use OAuth below)
# Create at https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=

# GitHub OAuth app (authorization code + PKCE) — preferred over pasting a PAT locally
# Register at https://github.com/settings/applications/new
# Callback URL: http://127.0.0.1:3000/api/github/oauth/callback (port may differ on loopback)
GITHUB_OAUTH_CLIENT_ID=
# Optional; often required for server-side token exchange. Keep in .env.local only, not in shipped builds.
GITHUB_OAUTH_CLIENT_SECRET=
# Optional; same value as GITHUB_OAUTH_CLIENT_ID for deep links (e.g. revoke UI in the app)
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=

# ── Optional ─────────────────────────────────────────────────────────
# Database driver: "sqlite" (default) or "postgres"
# DB_DRIVER=sqlite

# Postgres connection string (only when DB_DRIVER=postgres)
# DATABASE_URL=postgresql://...

# Data directory for SQLite DB, config, and vector data
# DOSSIER_DATA_DIR=~/.dossier/

# Override SQLite database file path
# SQLITE_PATH=

# Embedding model for RuVector
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Feature Flags ────────────────────────────────────────────────────
NEXT_PUBLIC_PLANNING_LLM_ENABLED=true
NEXT_PUBLIC_BUILD_ORCHESTRATOR_ENABLED=true
NEXT_PUBLIC_MEMORY_PLANE_ENABLED=true

# Agentic-flow (build execution plane)
# AGENTIC_FLOW_INTELLIGENCE=true  # Enable self-learning hooks (optional)
# AGENTIC_FLOW_NON_INTERACTIVE=true  # Set automatically when spawning subprocess

# ── Planning LLM ────────────────────────────────────────────────────
PLANNING_LLM_MODEL=claude-haiku-4-5-20251001
# Planning timeouts in milliseconds (SDK paths). Idle restarts on every agent action; overall caps one call.
# PLANNING_IDLE_TIMEOUT_MS=120000
# PLANNING_OVERALL_TIMEOUT_MS=1800000
