{
  "name": "dossier-agentic-product-planner-builder",
  "version": "0.5.7",
  "license": "PolyForm-Shield-1.0.0",
  "author": "Dossier",
  "repository": "https://github.com/rwliebs/Dossier",
  "description": "AI-native product craft platform — plan workflows, orchestrate multi-agent builds, ship iteratively",
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.js",
  "bin": {
    "dossier": "./bin/dossier.mjs"
  },
  "files": [
    "bin/",
    ".agents/",
    ".next/standalone/",
    ".next/static/",
    "public/",
    "THIRD-PARTY-NOTICES.md"
  ],
  "bundledDependencies": [
    "open"
  ],
  "scripts": {
    "postinstall": "node bin/postinstall.mjs",
    "build": "next build --webpack && npm run postbuild",
    "postbuild": "cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && bash scripts/copy-native-deps.sh",
    "dev": "next dev -H 127.0.0.1",
    "rebuild": "./scripts/rebuild-and-restart.sh",
    "rebuild:prod": "./scripts/rebuild-and-restart.sh prod",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run __tests__/e2e/",
    "test:e2e:adaptive": "vitest run __tests__/e2e/adaptive-flows.test.ts",
    "sync:action-buttons": "node scripts/sync-action-button-tests.mjs",
    "test:planning": "PLANNING_MOCK_ALLOWED=1 vitest run __tests__/api/chat-stream-mock.test.ts __tests__/lib/llm/stream-action-parser.test.ts",
    "test:planning:e2e": "vitest run __tests__/e2e/trading-card-marketplace-planning.test.ts",
    "test:e2e:project-to-cards": "vitest run __tests__/e2e/project-to-cards-flow.test.ts",
    "test:db": "vitest run __tests__/db/",
    "test:examples": "vitest run __tests__/examples/",
    "demo:mock-tasks": "tsx examples/run-mock-task-demo.ts",
    "generate:mock-task": "tsx examples/generate-mock-task.ts",
    "validate:payload": "tsx examples/validate-mock-payload.ts",
    "commit-all-to-branches": "tsx scripts/commit-all-to-branches.ts",
    "start": "next start",
    "dossier": "node bin/dossier.mjs",
    "release:alpha": "pnpm run build && pnpm publish --tag alpha --no-git-checks",
    "electron:prepare-node": "node scripts/prepare-electron-node.mjs",
    "electron:compile": "tsc -p electron",
    "electron:dev": "pnpm run electron:compile && electron-forge start",
    "electron:package": "pnpm run build && pnpm run electron:prepare-node && pnpm run electron:compile && electron-forge package",
    "electron:make": "pnpm run build && pnpm run electron:prepare-node && pnpm run electron:compile && electron-forge make",
    "electron:publish": "pnpm run electron:make && electron-forge publish",
    "prepare": "husky"
  },
  "dependencies": {
